<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="goliath">

  <!-- Import goliath Linear macro -->
  <xacro:include filename="$(find base_link_linear_controller)/urdf/base_link_linear.xacro"/>
  
  <!-- Import goliath macro -->
  <xacro:include filename="$(find ros2_control_demo_description)/goliath/urdf/goliath_description.urdf.xacro"/>

  <!-- Import goliath gripper macro -->
  <xacro:include filename="$(find gripper_controller)/urdf/gripper.xacro"/>
 
 
  <!-- create link fixed to the "world" 
  <link name="world"/> -->

  <xacro:goliath_description/>

  <!-- Import goliath slider ros2_control description -->
  <xacro:include filename="$(find base_link_linear_controller)/ros2_control/base_link_linear.ros2_control.xacro" />
  
  <!-- Import goliath ros2_control description -->
  <xacro:include filename="$(find goliath_controller)/ros2_control/goliath.ros2_control.xacro" />
  
  <!-- Import gripper ros2_control description -->
  <xacro:include filename="$(find gripper_controller)/ros2_control/gripper.ros2_control.xacro" /> 
  
  <xacro:goliath_ros2_control name="goliath"/>

</robot>
