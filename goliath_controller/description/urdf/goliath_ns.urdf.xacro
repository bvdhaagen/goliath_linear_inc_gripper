<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="goliath">

  <!-- ✅ Add namespace argument at the top level -->
  <xacro:arg name="namespace" default="robot_1"/>
  <xacro:arg name="use_sim_time" default="false"/>
  
  <!-- ✅ Create a property for easy access -->
  <xacro:property name="robot_namespace" value="$(arg namespace)"/>

<!-- ✅ Use namespaced version of base_link_linear -->
  <xacro:include filename="$(find base_link_linear_controller)/urdf/base_link_linear_ns.xacro"/>
  
  <!-- Import goliath macro -->
  <xacro:include filename="$(find ros2_control_demo_description)/goliath/urdf/goliath_description_ns.urdf.xacro"/>

  <!-- Import goliath gripper macro -->
  <xacro:include filename="$(find gripper_controller)/urdf/gripper_ns.xacro"/>
 
  <!-- Create link fixed to the "world" 
  <link name="world"/> -->

  <!-- ✅ Pass namespace to all macros -->
  <xacro:goliath_description namespace="$(arg namespace)"/>

  <!-- Import goliath slider ros2_control description -->
  <xacro:include filename="$(find base_link_linear_controller)/ros2_control/base_link_linear_ns.ros2_control.xacro" />
  
  <!-- Import goliath ros2_control description -->
  <xacro:include filename="$(find goliath_controller)/ros2_control/goliath_ns.ros2_control.xacro" />
  
  <!-- Import gripper ros2_control description -->
  <xacro:include filename="$(find gripper_controller)/ros2_control/gripper_ns.ros2_control.xacro" /> 
  
  <!-- ✅ Pass namespace to ros2_control -->
  <xacro:goliath_ns_ros2_control name="goliath" namespace="$(arg namespace)"/>

</robot>
