<?xml version="1.0"?>
<robot name="goliath" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ✅ Add namespace argument -->
  <xacro:arg name="namespace" default="robot_1"/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <xacro:macro name="goliath_description" params="namespace">
    <xacro:property name="ns" value="$(arg namespace)"/>
    
    <!-- helper macro -->
    <xacro:include filename="$(find ros2_control_demo_description)/goliath/urdf/inc/create_link_ns.xacro"/>

    <!-- ✅ All links prefixed with namespace -->
    <xacro:create_link_ns
        link_name="${ns}/arm_base_link"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_0"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_1"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_1"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_2"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_2"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_3"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_3"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_4"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_4"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_5"
        xyz_offset="0 0 0"
        rpy_offset="0 0 0"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="link_5"
    />

    <xacro:create_link_ns
        link_name="${ns}/link_6"
        xyz_offset="0.006 -0.009 0.006"
        rpy_offset="0 0 1.5775"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="tool_connector"
    />
    
    <!--
    <xacro:create_link_ns
        link_name="${ns}/weapon"
        xyz_offset="0.00 0.16 0.00"
        rpy_offset="0 0 1.5775"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="weapon2"
    /> 
    -->

    <xacro:create_link_ns
        link_name="${ns}/power_box"
        xyz_offset="0 0 0"
        rpy_offset="0 1.5775 0"
        material="silver"      
        mesh_package="ros2_control_demo_description/goliath"
        mesh_name="powerbox"
    />
    
    <!-- ARM JOINTS - All prefixed with namespace -->
    
    <joint name="${ns}/arm_base_joint" type="fixed">
      <parent link="${ns}/platform"/>
      <child link="${ns}/arm_base_link"/>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- joints - main serial chain -->
    
    <joint name="${ns}/joint_1" type="revolute">
      <parent link="${ns}/arm_base_link"/>
      <child link="${ns}/link_1"/>
      <origin xyz="0 0 0.104" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <joint name="${ns}/joint_2" type="revolute">
      <parent link="${ns}/link_1"/>
      <child link="${ns}/link_2"/>
      <origin xyz="0 -0.060768 0.1694" rpy="${-pi/2} ${-pi/2} ${pi}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi/2}" upper="${pi/2}" velocity="2.5"/>
    </joint>

    <joint name="${ns}/joint_3" type="revolute">
      <parent link="${ns}/link_2"/>
      <child link="${ns}/link_3"/>
      <origin xyz="0.315 0 -0.0198" rpy="0 ${pi} 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi/1.2}" upper="${pi/1.2}" velocity="2.5"/>
    </joint>

    <joint name="${ns}/joint_4" type="revolute">
      <parent link="${ns}/link_3"/>
      <child link="${ns}/link_4"/>
      <origin xyz="0.066258 0 0.036577" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <joint name="${ns}/joint_5" type="revolute">
      <parent link="${ns}/link_4"/>
      <child link="${ns}/link_5"/>
      <origin xyz="0.02456 0 -0.319213" rpy="0 ${pi/2} ${pi}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi/1.5}" upper="${pi/1.5}" velocity="2.5"/>
    </joint>

    <joint name="${ns}/joint_6" type="revolute">
      <parent link="${ns}/link_5"/>
      <child link="${ns}/link_6"/>
      <origin xyz="0.07318 0 0.02" rpy="0 ${pi/2} 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-pi}" upper="${pi}" velocity="2.5"/>
    </joint>

    <!-- TOOL JOINTS -->
    
    <joint name="${ns}/joint_tool_connector_frame" type="fixed">
      <parent link="${ns}/link_6"/>
      <child link="${ns}/tool_base"/>
      <origin xyz="0 0 0.017" rpy="0 0 ${pi/2}"/>
    </joint>
         
    <!--  <joint name="${ns}/joint_weapon" type="fixed">
      <parent link="${ns}/tool_base"/>
      <child link="${ns}/weapon"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint> -->
    
    <joint name="${ns}/joint_powebox" type="fixed">
      <parent link="${ns}/link_1"/>
      <child link="${ns}/power_box"/>
      <origin xyz="0 -0.002 -0.108" rpy="${pi/2} ${-pi/2} 0"/>
    </joint>

  </xacro:macro>

</robot>
