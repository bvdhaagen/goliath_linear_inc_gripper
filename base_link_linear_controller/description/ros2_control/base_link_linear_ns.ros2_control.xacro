<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ✅ Macro name and parameters -->
  <xacro:macro name="base_link_linear_ns_ros2_control" params="name namespace">
    
    <xacro:property name="ns" value="$(arg namespace)"/>
    
    <ros2_control name="${name}" type="system">
      <hardware>
        <!-- ✅ Use mock_components/GenericSystem (available in ROS2) -->
        <plugin>mock_components/GenericSystem</plugin>
        <param name="mock_sensor_commands">true</param>
      </hardware>
      
      <!-- Namespaced joints -->
      <joint name="${ns}/slider_11">
        <command_interface name="position"/>
        <state_interface name="position"/>
      </joint>
      
    </ros2_control>
    
  </xacro:macro>
  
</robot>
